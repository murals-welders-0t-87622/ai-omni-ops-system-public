{
  "name": "@ai-omni/shared",
  "version": "0.1.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "import": "./dist/*.js"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "require": "./src/*.ts",
      "import": "./src/*.ts"
    }
  }
}
