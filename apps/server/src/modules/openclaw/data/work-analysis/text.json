                "not_found",
                "unknown",
                "not_applicable"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "observation": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "snapshotRef",
                  "paragraphId",
                  "startChar",
                  "endChar",
                  "quote"
