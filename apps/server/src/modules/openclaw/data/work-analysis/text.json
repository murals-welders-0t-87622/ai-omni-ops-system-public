                "properties": {
                  "status": {
                    "const": "observed"
                  }
                }
              },
              "then": {
                "properties": {
                  "observation": {
                    "minLength": 1
                  },
                  "reason": {
                    "minLength": 1
                  },
                  "evidence": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      },
