model WfSchemaMigration {
  version   Int    @id
  appliedAt String @db.VarChar(64)

  @@map("wf_schema_migrations")
}

model WfTask {
  taskId           String          @id @db.VarChar(64)
  brandId        String        @db.VarChar(64)
  goal            String        @db.Text
  scopeEnd      String        @db.Text
  routeId       String        @db.VarChar(256)
  routeVersion  String        @db.VarChar(64)
  contentFamily String?       @db.VarChar(128)
  status        WfTaskStatus
  revision      Int           @default(1)
  archiveStatus WfArchiveStatus @default(PENDING)
  authority     WfAuthority     @default(LOCAL)
  parentId      String?       @db.VarChar(64)
  workspacePath String        @db.VarChar(512)
  sourceRefs    Json
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  parent       WfTask?       @relation("WfTaskHierarchy", fields: [parentId], references: [taskId], onDelete: SetNull)
  children     WfTask[]      @relation("WfTaskHierarchy")
  stageRuns    WfStageRun[]
  artifacts    WfArtifact[]
  approvals    WfApproval[]
  gateResults  WfGateResult[]
  versionUsages WfVersionUsage[]
  domainEvents WfDomainEvent[]
  executionEvents WfExecutionEvent[]
  guardedToolCalls WfGuardedToolCall[]

  @@index([brandId, status, createdAt])
  @@index([parentId])
  @@index([routeId, routeVersion])
  @@map("wf_tasks")
}

model WfStageRun {
  stageRunId               String          @id @db.VarChar(128)
  taskId                   String        @db.VarChar(64)
  stageKey               String        @db.VarChar(128)
  generation             Int
  ownerExpertId         String        @db.VarChar(128)
  status                 WfStageStatus
  dependenciesJson       Json
  requiresJson         Json
  producesJson        Json
  workMode               WfWorkMode    @default(EXPERT_WORK)
  approvalMode         String?       @db.VarChar(64)
  inputRevision          Int           @default(1)
  outputArtifactRevisionIds Json
  leaseId             String?       @db.VarChar(128)
  fencingToken           Int           @default(0)
  leaseExpiresAt        DateTime?
  clientId            String?       @db.VarChar(128)
  executorId           String?       @db.VarChar(128)
  currentAttemptId      String?       @db.VarChar(128)
  createdAt            DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  task              WfTask              @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  executionAttempts   WfExecutionAttempt[]
  executionLeases   WfExecutionLease[]
  approvals          WfApproval[]
  gateResults       WfGateResult[]
  executionEvents    WfExecutionEvent[]

  @@unique([taskId, stageKey, generation])
  @@index([taskId, status])
  @@index([ownerExpertId, status])
  @@map("wf_stage_runs")
}

model WfArtifact {
  artifactRevisionId String   @id @db.VarChar(128)
  artifactId       String @db.VarChar(128)
  revisionNo     Int
  taskId         String @db.VarChar(64)
  kind              String @db.VarChar(128)
  localPath      String @db.VarChar(1024)
  sha256          String @db.VarChar(64)
  byteLength       Int
  mimeType      String @db.VarChar(128)
  metadata        Json
  sourceRefs      Json
  createdAt       DateTime @default(now())

  task WfTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@unique([artifactId, revisionNo])
  @@index([taskId, kind])
  @@map("wf_artifacts")
}

model WfExecutionAttempt {
  attemptId   String              @id @db.VarChar(128)
  stageRunId String              @db.VarChar(128)
  attemptNo    Int
  clientId     String              @db.VarChar(128)
  startedAt  DateTime
  endedAt    DateTime?
  outcome    WfExecutionOutcome?

  stageRun         WfStageRun       @relation(fields: [stageRunId], references: [stageRunId], onDelete: Cascade)
  executionLeases WfExecutionLease[]

  @@index([stageRunId, attemptNo])
  @@map("wf_execution_attempts")
}

model WfExecutionLease {
  leaseId       String             @id @db.VarChar(128)
  stageRunId    String             @db.VarChar(128)
  attemptId     String             @db.VarChar(128)
  clientId      String             @db.VarChar(128)
  executorId    String             @db.VarChar(128)
  fencingToken  Int
  acquiredAt    DateTime
  expiresAt   DateTime
  revokedAt     DateTime?

  stageRun       WfStageRun         @relation(fields: [stageRunId], references: [stageRunId], onDelete: Cascade)
  executionAttempt WfExecutionAttempt @relation(fields: [attemptId], references: [attemptId], onDelete: Cascade)

  @@index([stageRunId])
  @@map("wf_execution_leases")
}

model WfApproval {
  approvalId              String               @id @db.VarChar(128)
  taskId                 String               @db.VarChar(64)
  stageRunId             String               @db.VarChar(128)
  scope                   String               @db.VarChar(128)
  decision              WfApprovalDecision
  artifactRevisionIds Json
  evidenceRef             String               @db.Text
  actorId               String               @db.VarChar(128)
  createdAt              DateTime             @default(now())

  task       WfTask     @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  stageRun WfStageRun @relation(fields: [stageRunId], references: [stageRunId], onDelete: Cascade)

  @@index([taskId, scope])
  @@index([stageRunId, decision])
  @@map("wf_approvals")
}

model WfGateResult {
  gateResultId    String          @id @db.VarChar(128)
  taskId         String          @db.VarChar(64)
  stageRunId    String          @db.VarChar(128)
  verdict      WfGateVerdict
  score       Float?
  threshold     Float?
  assessment  Json
  createdAt  DateTime @default(now())

  task     WfTask     @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  stageRun WfStageRun @relation(fields: [stageRunId], references: [stageRunId], onDelete: Cascade)

  @@index([taskId, verdict])
  @@map("wf_gate_results")
}

model WfVersionRelease {
  releaseId        String            @id @db.VarChar(128)
  packageVersion String?           @db.VarChar(128)
  manifestHash    String            @unique @db.VarChar(128)
  snapshotPath  String            @db.VarChar(1024)
  manifest      Json
  status          WfReleaseStatus
  createdAt       DateTime          @default(now())

  versionUsages WfVersionUsage[]

  @@index([status, createdAt])
  @@map("wf_version_releases")
}

model WfVersionUsage {
  usageId          String                  @id @db.VarChar(128)
  taskId           String                  @db.VarChar(64)
  releaseId        String                  @db.VarChar(128)
  startedAt        DateTime
  endedAt          DateTime?
  desiredRevision String                  @db.VarChar(128)
  installedStatus  WfVersionInstalledStatus @default(UNVERIFIED)
  loadedStatus     WfVersionInstalledStatus @default(UNVERIFIED)
  evidence      Json

  task            WfTask            @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  release      WfVersionRelease @relation(fields: [releaseId], references: [releaseId], onDelete: Cascade)

  @@unique([taskId, releaseId])
  @@map("wf_version_usages")
}

model WfIdempotencyRecord {
  scope          String @db.VarChar(128)
  idempotencyKey String @db.VarChar(256)
  requestHash  String @db.VarChar(128)
  responseJson    Json
  createdAt     DateTime @default(now())

  @@id([scope, idempotencyKey])
  @@map("wf_idempotency_records")
}

model WfDomainEvent {
  eventSeq        BigInt        @id @default(autoincrement())
  eventId         String        @unique @db.VarChar(128)
  taskId          String        @db.VarChar(64)
  commandId       String?       @db.VarChar(128)
  kind            WfEventKind
  fromRevision    Int
  toRevision   Int
  actorId       String        @db.VarChar(128)
  payload        Json
  createdAt      DateTime      @default(now())

  task WfTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@index([taskId, kind])
  @@index([commandId])
  @@map("wf_domain_events")
}

model WfExecutionEvent {
  eventId                  String              @id @db.VarChar(128)
  taskId                   String              @db.VarChar(64)
  invocationId               String              @db.VarChar(128)
  parentInvocationId    String?             @db.VarChar(128)
  recoveryForInvocationId String?             @db.VarChar(128)
  stageRunId            String?             @db.VarChar(128)
  subjectKind           WfSubjectKind
  subjectId             String              @db.VarChar(128)
  eventType            WfExecutionEventType
  attemptNo               Int
  errorCode             String?             @db.VarChar(64)
  errorMessage          String?             @db.Text
  recoveryMethod       String?             @db.VarChar(128)
  evidenceRefsJson      Json
  sourceLevel            String              @db.VarChar(64)
  commandId         String              @db.VarChar(128)
  createdAt        DateTime            @default(now())

  task      WfTask?     @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  stageRun WfStageRun? @relation(fields: [stageRunId], references: [stageRunId], onDelete: SetNull)

  @@index([taskId, eventType])
  @@index([invocationId])
  @@index([stageRunId])
  @@map("wf_execution_events")
}

model WfGuardedToolCall {
  callId        String                @id @db.VarChar(128)
  taskId       String                @db.VarChar(64)
  requestId      String                @db.VarChar(128)
  requestHash  String                @db.VarChar(128)
  contentKey    String                @unique @db.VarChar(256)
  recoveryFor   String?               @db.VarChar(128)
  status         WfGuardedCallStatus
  toolName      String                @db.VarChar(256)
  startedAt    DateTime
  endedAt      DateTime?
  topicId      String?               @db.VarChar(128)
  errorCode       String?               @db.VarChar(64)

  task            WfTask              @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  recoveryOf WfGuardedToolCall?  @relation("WfGuardedRecovery", fields: [recoveryFor], references: [callId], onDelete: SetNull)
  recoveries   WfGuardedToolCall[] @relation("WfGuardedRecovery")
  events        WfGuardedToolEvent[]

  @@index([taskId, status])
  @@map("wf_guarded_tool_calls")
}

model WfGuardedToolEvent {
  seq         BigInt              @id @default(autoincrement())
  callId    String              @db.VarChar(128)
  kind      String              @db.VarChar(128)
  detailsJson Json
  createdAt DateTime            @default(now())

  call WfGuardedToolCall @relation(fields: [callId], references: [callId], onDelete: Cascade)

  @@index([callId, kind])
  @@map("wf_guarded_tool_events")
}

/// --- Phase 3 Ontology Mapper + Outbox + Reconciliation（治理真值 v3 对齐） ---

enum OntPreconditionVerdict {
  PASS
  WEAK_WARNING
  BLOCKED
  @@map("ont_precondition_verdict")
}

enum OntViewKind {
  LOGICAL
  PHYSICAL
  RUNTIME
  @@map("ont_view_kind")
}

enum OntOntologyKind {
  BRAND
  TASK
  MEDIA
  @@map("ont_ontology_kind")
}

enum OntOutboxEventType {
  task_created
  task_status_changed
  task_paused
  task_resumed
  task_canceled
  task_closed
  task_archived
  task_reopened_archive
  stage_claimed
  stage_submitted
  stage_accepted
  stage_changes_requested
  stage_blocked
  approval_recorded
  artifact_registered
  version_used
  release_created
  release_verified
  release_restored
  domain_event_appended
  guarded_tool_called
  guarded_tool_completed
  @@map("ont_outbox_event_type")
}

enum OntReconcileSide {
  PYTHON_SQLITE
  TS_PRISMA
  REFERENCE_TRUTH
  @@map("ont_reconcile_side")
}

model OntologyOutbox {
  id                       String              @id @default(cuid()) @map("outbox_id")
  eventType                OntOutboxEventType  @map("event_type")
  sourceTable              String              @map("source_table")
  sourceRecordId           String              @map("source_record_id")
  brandId                  String              @map("brand_id")
  payloadJson              Json                @map("payload_json")
  dispatched               Boolean             @default(false) @map("dispatched")
  createdAt                DateTime            @default(now()) @map("created_at")
  dispatchedAt             DateTime?           @map("dispatched_at")
  pipelineIdsDispatched    String[]            @default([]) @map("pipeline_ids_dispatched")
  pipelineAssigned         String?             @db.VarChar(16) @map("pipeline_assigned")
  retryCount               Int                 @default(0) @map("retry_count")
  maxRetry                 Int                 @default(3) @map("max_retry")
  lastError                String?             @db.Text @map("last_error")
  lastProcessedAt          DateTime?           @map("last_processed_at")
  dlqMovedAt               DateTime?           @map("dlq_moved_at")
  dlqReason                String?             @db.VarChar(512) @map("dlq_reason")

  @@index([brandId, createdAt])
  @@index([dispatched, createdAt])
  @@index([eventType, sourceRecordId])
  @@index([retryCount, dlqMovedAt])
  @@index([pipelineAssigned, dispatched])
  @@unique([sourceTable, sourceRecordId, eventType], name: "ont_outbox_src_event_unique")
  @@map("ontology_outboxes")
}

model OntologyMapping {
  id               String         @id @default(cuid())
  ontologyKind     OntOntologyKind @map("ontology_kind")
  viewKind         OntViewKind    @map("view_kind")
  logicalKey       String         @map("logical_key")
  physicalPath     String?        @map("physical_path")
  runtimeSource    String?        @map("runtime_source")
  brandId          String?        @map("brand_id")
  taskId           String?        @map("task_id")
  mediaId          String?        @map("media_id")
  assetId          String?        @map("asset_id")
  fieldWhitelist   String[]       @default([]) @map("field_whitelist")
  descriptionJson  Json?          @map("description_json")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  businessAsset BusinessAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([ontologyKind, viewKind, logicalKey])
  @@index([brandId, ontologyKind])
  @@unique([ontologyKind, viewKind, logicalKey], name: "ont_mapping_kind_view_key_unique")
  @@map("ontology_mappings")
}

model OntologyPreconditionCheck {
  id               String                  @id @default(cuid())
  checkId          String                  @unique @map("check_id")
  brandId          String                  @map("brand_id")
  taskId           String?                 @map("task_id")
  routeId          String?                 @map("route_id")
  verdict          OntPreconditionVerdict  @map("verdict")
  ruleId           String                  @map("rule_id")
  ruleCode         String                  @map("rule_code")
  resourceDesc     String                  @map("resource_desc") @db.VarChar(1024)
  actionHint       String                  @map("action_hint")   @db.VarChar(1024)
  detailsJson      Json?                   @map("details_json")
  checkedAt        DateTime                @default(now()) @map("checked_at")

  @@index([brandId, checkedAt])
  @@index([taskId, verdict])
  @@map("ontology_precondition_checks")
}

model OntologyDualWriteReconcileLog {
  id                 String            @id @default(cuid())
  batchId            String            @map("batch_id")
  sourceTable        String            @map("source_table")
  primaryKey         String            @map("primary_key")
  side               OntReconcileSide  @map("side")
  fieldName          String            @map("field_name")
  expectedValue      Json?             @map("expected_value")
  actualValue        Json?             @map("actual_value")
  matched            Boolean           @map("matched")
  comparedAt         DateTime          @default(now()) @map("compared_at")

  @@index([batchId, matched])
  @@index([sourceTable, primaryKey])
  @@map("ontology_dual_write_reconcile_logs")
}

model OntologyReadOnlyHandlerCache {
  id               String   @id @default(cuid())
  handlerName      String   @unique @map("handler_name")
  argumentsDigest  String   @map("arguments_digest") @db.VarChar(128)
  payloadJson      Json     @map("payload_json")
  generatedAt      DateTime @default(now()) @map("generated_at")

  @@index([handlerName, generatedAt])
  @@unique([handlerName, argumentsDigest], name: "ont_read_cache_handler_args_unique")
  @@map("ontology_read_only_handler_caches")
}

model OntologyOrchestrationFlow {
  id                 String   @id @default(cuid())
  flowKey            String   @unique @map("flow_key") @db.VarChar(128)
  name               String   @db.VarChar(256)
  description        String   @default("") @db.Text
  status             String   @default("draft") @db.VarChar(32)
  brandId            String?  @map("brand_id") @db.VarChar(128)
  workspaceScope     String   @default("all_network_growth") @map("workspace_scope") @db.VarChar(128)
  targetKind         String   @default("expert_team") @map("target_kind") @db.VarChar(64)
  targetId           String   @default("") @map("target_id") @db.VarChar(256)
  targetName         String   @default("") @map("target_name") @db.VarChar(256)
  sourceRefsJson     Json     @map("source_refs_json")
  routingRulesJson   Json     @map("routing_rules_json")
  confirmationGatesJson Json  @map("confirmation_gates_json")
  evidenceRulesJson  Json     @map("evidence_rules_json")
  createdBy          String   @default("system") @map("created_by") @db.VarChar(128)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  nodes              OntologyOrchestrationNode[]
  edges              OntologyOrchestrationEdge[]
  versions           OntologyOrchestrationVersion[]

  @@index([brandId, status, updatedAt])
  @@index([targetKind, targetId])
  @@map("ontology_orchestration_flows")
}

model OntologyOrchestrationNode {
  id              String   @id @default(cuid())
  flowId          String   @map("flow_id")
  nodeKey         String   @map("node_key") @db.VarChar(128)
  nodeType        String   @map("node_type") @db.VarChar(64)
  title           String   @db.VarChar(256)
  subtitle        String   @default("") @db.VarChar(256)
  description     String   @default("") @db.Text
  positionX       Int      @default(0) @map("position_x")
  positionY       Int      @default(0) @map("position_y")
  sortOrder       Int      @default(100) @map("sort_order")
  objectJson      Json     @map("object_json")
  linkJson        Json     @map("link_json")
  functionJson    Json     @map("function_json")
  actionJson      Json     @map("action_json")
  interfaceJson   Json     @map("interface_json")
  referencesJson  Json     @map("references_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  flow            OntologyOrchestrationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, nodeKey])
  @@index([flowId, nodeType, sortOrder])
  @@map("ontology_orchestration_nodes")
}

model OntologyOrchestrationEdge {
  id             String   @id @default(cuid())
  flowId         String   @map("flow_id")
  edgeKey        String   @map("edge_key") @db.VarChar(128)
  fromNodeKey    String   @map("from_node_key") @db.VarChar(128)
  toNodeKey      String   @map("to_node_key") @db.VarChar(128)
  label          String   @default("") @db.VarChar(256)
  conditionJson  Json     @map("condition_json")
  sortOrder      Int      @default(100) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  flow           OntologyOrchestrationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, edgeKey])
  @@index([flowId, fromNodeKey, toNodeKey])
  @@map("ontology_orchestration_edges")
}

model OntologyOrchestrationVersion {
  id            String    @id @default(cuid())
  flowId        String    @map("flow_id")
  versionNo     Int       @map("version_no")
  status        String    @default("draft_snapshot") @db.VarChar(64)
  snapshotJson  Json      @map("snapshot_json")
  createdBy     String    @default("system") @map("created_by") @db.VarChar(128)
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")

  flow          OntologyOrchestrationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, versionNo])
  @@index([flowId, createdAt])
  @@map("ontology_orchestration_versions")
}


// 独立作品拆解；不复用历史爆款HTML记录的身份，不生成开发用业务任务。
model WorkAnalysisRequest {
  id             String   @id
  brandId        String
  platform       String
  sourceId       String
  snapshotJson   String
  formsJson      String
  goal           String
  status         String   @default("pending")
  revision       Int      @default(1)
  generation     Int      @default(1)
  actorId        String
  claimedBy      String   @default("")
  eventsJson     String   @default("[]")
  idempotencyKey String
  payloadHash    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  results        WorkAnalysisResult[]

  @@unique([brandId, actorId, idempotencyKey])
  @@index([brandId, platform, updatedAt])
}

model WorkAnalysisResult {
  id                 String   @id
  requestId          String
  brandId            String
  platform           String
  generation         Int
  actorId            String
  title              String
  reportMarkdown     String
  reportHtml         String
  profilesJson       String
  snapshotJson       String
  methodVersionsJson String
  tagsText           String
  idempotencyKey     String
  payloadHash        String
  createdAt          DateTime @default(now())
  request            WorkAnalysisRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([requestId, generation])
  @@unique([requestId, idempotencyKey])
  @@index([brandId, platform, createdAt])
}


model GrowthPlan {
  id String @id
  brandId String
  createdBy String
  title String
  goal String
  scope String
  status String @default("awaiting_expert")
  revision Int @default(1)
  currentVersion Int @default(0)
  startDate String
  endDate String
  frequency String @default("daily")
  snapshotJson String
  eventsJson String @default("[]")
  claimedBy String @default("")
  leaseUntil DateTime?
  nextCheckAt DateTime?
  idempotencyKey String
  payloadHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions GrowthPlanVersion[]
  checks GrowthPlanCheck[]
  proposals GrowthPlanProposal[]
  @@unique([brandId, createdBy, idempotencyKey])
  @@index([brandId, updatedAt])
  @@index([status, nextCheckAt])
}
model GrowthPlanVersion {
  id String @id
  planId String
  brandId String
  version Int
  bodyJson String
  reportMarkdown String
  methodVersionsJson String
  snapshotJson String
  actorId String
  idempotencyKey String
  payloadHash String
  createdAt DateTime @default(now())
  plan GrowthPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@unique([planId, version])
  @@unique([planId, idempotencyKey])
}
model GrowthPlanCheck {
  id String @id
  planId String
  brandId String
  version Int
  windowStart String
  windowEnd String
  snapshotHash String
  snapshotJson String
  status String
  reason String
  revision Int @default(1)
  claimedBy String @default("")
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  plan GrowthPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@unique([planId, version, windowEnd, snapshotHash])
  @@index([brandId, status, createdAt])
}
model GrowthPlanProposal {
  id String @id
  planId String
  brandId String
  checkId String @unique
  baseVersion Int
  actionsJson String
  reportMarkdown String
  methodVersionsJson String
  actorId String
  decision String @default("pending")
  idempotencyKey String
  payloadHash String
  createdAt DateTime @default(now())
  plan GrowthPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@unique([planId, idempotencyKey])
}
model GrowthMetricFact {
  id String @id
  brandId String
  metricKey String
  date String
  value Float
  sampleSize Int
  basis String
  sourceRef String
  actorId String
  revision Int
  observedAt DateTime
  idempotencyKey String
  payloadHash String
  createdAt DateTime @default(now())
  @@unique([brandId, metricKey, date, revision])
  @@unique([brandId, actorId, idempotencyKey])
  @@index([brandId, metricKey, date])
}


model BrandExecutionProfile {
  id              String @id
  brandId         String @unique
  revision        Int @default(0)
  activeVersionId String?
  draftJson       Json
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  brand           Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  versions        BrandExecutionProfileVersion[]
}

model BrandExecutionProfileVersion {
  id              String @id
  profileId       String
  brandId         String
  version         Int
  configJson      Json
  contentHash     String
  restoredFromId  String?
  createdByUserId String
  createdAt       DateTime @default(now())
  profile         BrandExecutionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([profileId, version])
  @@index([brandId, createdAt])
}


// Append-only, brand-scoped material indexing; original records and previous revisions remain intact.
model MaterialArchiveRevision {
  id String @id
  brandId String
  evidenceTable String
  recordId String
  revision Int
  actorId String
  operation String
  payloadJson String
  createdAt DateTime @default(now())
  @@unique([brandId, evidenceTable, recordId, revision], map: "MaterialArchiveRevision_brandId_evidenceTable_recordId_revision")
  @@index([brandId, createdAt])
}

model MarketingCalendarRevision {
  id String @id
  brandId String
  reportId String
  revision Int
  actorId String
  operation String
  idempotencyKey String?
  commandHash String
  snapshotJson String
  contentHash String
  createdAt DateTime @default(now())
  @@unique([brandId, reportId, revision], map: "MarketingCalendarRevision_brand_report_revision")
  @@unique([brandId, idempotencyKey], map: "MarketingCalendarRevision_brand_key")
  @@index([brandId, createdAt])
}
